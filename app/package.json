{
  "name": "nova-browser",
  "version": "1.0.5",
  "description": "Night Browser - navigateur de bureau Electron",
  "homepage": "https://jujulian1607h.github.io/nova-browser/",
  "main": "main.cjs",
  "author": {
    "name": "NOVA",
    "email": "222992817+jujulian1607h@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage deb",
    "test": "node --test *.test.cjs website/*.test.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "@electron/get": "5.1.0"
  },
  "build": {
    "appId": "com.nova.browser",
    "productName": "Night Browser",
    "publish": [
      {
        "provider": "github",
        "owner": "jujulian1607h",
        "repo": "nova-browser"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "history-store.cjs",
      "download-manager.cjs",
      "preload.cjs",
      "index.html",
      "renderer.js",
      "styles.css",
      "package.json"
    ],
    "win": {
      "artifactName": "Night-Browser-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network",
      "synopsis": "Navigateur web Night Browser",
      "description": "Night Browser est un navigateur de bureau avec onglets, favoris, historique local et gestionnaire de telechargements.",
      "artifactName": "Night-Browser-${version}-${arch}.${ext}"
    }
  }
}
